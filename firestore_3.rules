rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Har gym ka data sirf usi gym ke login ko dikhega
    match /gyms/{gymId} {
      allow read, write: if request.auth != null && request.auth.uid == gymId;
    }
    match /gyms/{gymId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == gymId;
    }
  }
}